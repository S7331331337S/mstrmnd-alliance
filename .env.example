# Backend origin for the MSTRMND OS agent runtime (eve at /eve/v1/*).
#
# Production OS (Vercel):
# EXPO_PUBLIC_MSTRMND_API_URL=https://mstrmnd-core.vercel.app
#
# Local self-host:
# EXPO_PUBLIC_MSTRMND_API_URL=http://192.168.1.20:3000
#
# Leave unset to run demo mode against local OS roster stub data.
#
# DO NOT use https://mstrmnd-alliance.vercel.app — that host is dead (NOT_FOUND)
# and retired in docs only. No DNS work. Preview via Expo web / EAS instead.

EXPO_PUBLIC_MSTRMND_API_URL=https://mstrmnd-core.vercel.app

# Session JWT via env-paste (EXPO_PUBLIC_MSTRMND_SESSION) is legacy / deprecated.
# Prefer Settings → Connect (runtime sign-in) once that PR lands. Until then,
# env-paste still works on main but should not be used for new setups.
