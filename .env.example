# Backend origin for the MSTRMND OS agent runtime (eve at /eve/v1/*).
#
# Production OS (Vercel):
# EXPO_PUBLIC_MSTRMND_API_URL=https://mstrmnd-core.vercel.app
#
# Local self-host:
# EXPO_PUBLIC_MSTRMND_API_URL=http://192.168.1.20:3000
#
# Leave unset to run demo mode against local OS roster stub data.

EXPO_PUBLIC_MSTRMND_API_URL=https://mstrmnd-core.vercel.app

# Optional eve session JWT (same token OS signs into the `mstrmnd_session` cookie).
# When set, Alliance sends `Authorization: Bearer <jwt>` on `/eve/v1/*` calls.
# Obtain via OS sign-in (`POST /api/auth/signin`); paste the returned session token.
# Leave unset for unauthenticated / demo use (eve may reject live turns).
#
# EXPO_PUBLIC_MSTRMND_SESSION=